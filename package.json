{
  "name": "geodiario-backend",
  "version": "1.0.0",
  "description": "Backend de GeoDiario",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --env-file .env --watch index.js",
    "import:countries": "node --env-file .env src/scripts/importPaises.js",
    "update:difficulties": "node --env-file .env src/scripts/actualizarDificultades.js",
    "translate:countries": "node --env-file .env src/scripts/traducirPaisesCapitales.js"
  },
  "keywords": [
    "juegos diarios",
    "GeoDiario",
    "juegos de geografia"
  ],
  "author": "Blanco Juan Manuel",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "i18n-iso-countries": "^7.14.0",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0"
  }
}
